APP_NAME="ITFA Student Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://student.itfa.edu.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Shared database: the SAME enrollment_db the native ITFA app uses ──────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enrollment_db
DB_USERNAME=root
DB_PASSWORD=
# Must match the existing DB's collation (avoids "illegal mix of collations").
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

# File-based drivers → the portal creates NO tables in the shared DB.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
# Distinct cookie so a subfolder deploy never collides with the native app session.
SESSION_COOKIE=itfa_portal_session

QUEUE_CONNECTION=sync
CACHE_STORE=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@itfa.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ── Shared assets/uploads from the native app ────────────────────────────────
# Filesystem path the portal reads/writes student photos + teacher signatures.
#  · Subfolder deploy (portal/ inside the native app): leave unset (defaults to ../uploads).
#  · Subdomain deploy: point at the shared/synced uploads folder on the server.
# SHARED_UPLOADS_PATH=/home/itfa/enrollment/uploads
# Public URL that serves those uploads (student photos on the dashboard, etc.).
SHARED_UPLOADS_URL=https://itfa.edu.ph/enrollment/uploads
# Public URL of the native app root (school logo + certificate QR verify target).
SHARED_APP_URL=https://itfa.edu.ph/enrollment

# ── Super Admin maintenance console (/admin) ─────────────────────────────────
# Which native staff roles may sign in to /admin (comma-separated, lower-case).
# Reuses enrollment_users / user_account credentials — no separate password.
PORTAL_ADMIN_ROLES="super admin"
# Where console-created DB backups are written (kept out of the web root).
# PORTAL_BACKUP_PATH=/home/itfa/portal-backups
# Full path to mysqldump if it is not auto-detected (cPanel: usually /usr/bin/mysqldump).
# MYSQLDUMP_BIN=/usr/bin/mysqldump
