# ==========================================================================
# ITFA I-SMS  ·  .gitignore
# Keeps secrets, live credentials, real student data, and build artifacts
# OUT of version control. Review before committing new file types.
# ==========================================================================

# ---- Secrets & live credentials (NEVER commit) --------------------------
credentials.txt
config/online_database.php
portal/.env
portal/.env.*
!portal/.env.example
.env
*.pem
*.key

# ---- Real database dumps / backups (contain student PII) ----------------
Online database*.sql
enrollment_db.sql
*.zip

# NOTE: schema-only / migration SQL is intentionally KEPT
# (lms_live_migration.sql, cashier_schema_update.sql,
#  schema_update_session.sql, cashier_fees_update.sql)

# ---- Uploaded media (student/teacher PII) -------------------------------
# Keep the folder structure (.gitkeep) but not the actual uploads.
uploads/**
!uploads/
!uploads/**/
!uploads/**/.gitkeep

# Loose student photos left in the project root
BAJUNAID GARAY.png
Pahima Tahir.png

# ---- Native app runtime ------------------------------------------------
storage/sessions/*
!storage/sessions/.gitkeep

# ---- Laravel portal (framework artifacts) -------------------------------
portal/vendor/
portal/node_modules/
portal/public/build/
portal/public/hot
portal/public/storage
# Student-uploaded profile photos (PII) — keep the folder, not the images
portal/public/student-photos/*
!portal/public/student-photos/
!portal/public/student-photos/.gitkeep
# LMS-uploaded lesson/assignment media (PII) — keep folder, not contents
portal/public/lms-uploads/*
!portal/public/lms-uploads/
!portal/public/lms-uploads/.gitkeep
portal/storage/*.key
portal/storage/app/public/*
!portal/storage/app/public/.gitkeep
portal/storage/framework/cache/*
portal/storage/framework/sessions/*
portal/storage/framework/testing/*
portal/storage/framework/views/*
portal/storage/logs/*
portal/bootstrap/cache/*
!portal/bootstrap/cache/.gitignore

# ---- OS / editor junk ---------------------------------------------------
Thumbs.db
.DS_Store
*.log

# Database backups (contain student PII — never commit)
/storage/backups/*.sql
/storage/backups/*.sql.gz

# Simulation account credentials (usernames + temp password) — never commit
/teacher_accounts_sim.csv
/reset_teacher_passwords_sim.sql

# Marketing / launch graphics
/ITFA_Student_Portal_Launch*.png

# ---- Live data & one-off operational scripts (student PII) — NEVER commit ----
# Full live DB dumps
/thrgd534_grading*.sql
# Teacher-reported issue screenshots + LRN-correction document
/errors/
# One-off data-fix scripts that hard-code live student names / LRNs
/fix_*.sql
/cleanup_*.sql
/reconcile_remaining_sections.sql
# Local diagnostic probe (not for the repo)
/portal/public/photo-check.php
/portal/public/student-photos/_probe*
# Simulation artifacts
/cleanup_sim/
/cleanup_sim
